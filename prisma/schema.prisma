// Data model for the debt & equity platform.
//
// NOT VALIDATED IN THIS SANDBOX: the environment this was written in has no outbound
// access to the npm registry, so `prisma` itself could not be installed here to run
// `prisma validate` / `prisma generate` against this file. The syntax below was written
// carefully against the Prisma schema reference, but run `npx prisma validate` yourself
// as the very first step before building on it.
//
// Three design decisions worth flagging to whoever picks this up:
//
// 1. Instruments are polymorphic via a `type` enum + a JSON `terms` payload, not one
//    table per instrument type. Cap tables have to render every instrument type in one
//    list/one UI, and the "maintain flexibility for future functionality add-ons"
//    requirement means new instrument types will get added after this ships — a rigid
//    column-per-type model fights both of those. The calculation engine (src/lib/
//    accounting) is what actually understands each terms shape; this schema just
//    stores and versions it.
//
// 2. InstrumentTermVersion is append-only and mirrors modificationEngine.ts exactly —
//    every modification is a new row with its own effectiveDate, never an UPDATE to an
//    existing row. If you ever find code UPDATE-ing a row in this table, that's the
//    architecture requirement being violated, not a valid shortcut.
//
// 3. SUPERSEDED IN PART (v0.47.0): this note originally said Documents point at a
//    `storageUrl` rather than storing file bytes in Postgres, because of an earlier
//    stack decision to buy the e-signature/redlining workflow (PandaDoc/DocuSign)
//    rather than build one — this table was purely a pointer into that vendor's
//    storage plus a status column, not a document store of its own. George then asked,
//    verbatim, to actually "retain all contracts/agreements" and link them to
//    investors in the cap table — real document retention this app owns, not just a
//    pointer into someone else's system. `DocumentVersion` now supports BOTH: the
//    original `storageUrl` (still there, still nullable-by-nature, for anyone still
//    pointing at PandaDoc/DocuSign) and a new `storagePath` (a Supabase Storage object
//    key this app actually uploaded and owns — see supabaseStorage.ts). A given version
//    has exactly one or the other, never neither. `Document` also gained a
//    `stakeholderId` — the vast majority of what gets uploaded (an option agreement, a
//    stock purchase agreement, a side letter) belongs to a specific investor/
//    stakeholder, not just an instrument or the entity in the abstract.
//
// 4. Multi-tenancy is a join table (EntityAccess), not a `tenantId` column on every
//    row. A user's access is to an ENTITY (and everything under it — stakeholders,
//    instruments, schedules), not to individual rows, and one user can reasonably need
//    access to more than one entity (an accountant serving several clients) — a single
//    `tenantId` foreign key per table can't express that, but one join table checked
//    once per request (src/lib/auth/access.ts) can. See User/EntityRole/EntityAccess
//    below, and src/middleware.ts + every API route/page under src/app/ for where that
//    check actually happens.

generator client {
  provider      = "prisma-client-js"
  // "native" keeps local development working (whatever OS/arch you run `prisma
  // generate` on yourself); "rhel-openssl-3.0.x" is Vercel's actual Node.js serverless
  // Function runtime — a different OS/architecture than the build container "native"
  // targets, which is exactly the mismatch DEPLOYMENT.md's troubleshooting section
  // flagged as a likely first-deploy failure mode, without hard-coding a value that
  // couldn't be verified against a live deploy at the time. Confirmed necessary here:
  // without this, `prisma generate` (via postinstall) only produces the query engine
  // binary for the build machine, so `db.user.findUnique` and every other real query
  // throws a PrismaClientInitializationError the first time a route actually touches
  // the database in production — which Next.js's production error handling then
  // returns as a bare 500 with an empty body, not a helpful error message, which is
  // exactly what showed up in the browser at login.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase (and most managed Postgres providers used from a serverless host like
  // Vercel) need two different connection strings: a pooled connection (PgBouncer,
  // port 6543, "?pgbouncer=true") that Prisma Client uses at runtime, since a
  // serverless function can't hold a persistent connection the way a long-running
  // server can; and an unpooled connection (port 5432) that `prisma migrate` /
  // `prisma db push` need, since schema changes can't run through a transaction
  // pooler.
  //
  // UPDATED to read `POSTGRES_PRISMA_URL` / `POSTGRES_URL_NON_POOLING` instead of a
  // hand-set `DATABASE_URL` / `DIRECT_URL` — these are the names the Vercel Marketplace
  // "Connect Existing Project" Supabase integration creates automatically, populated
  // directly from Supabase's own systems rather than a person copying, retyping, or
  // reassembling a connection string by hand (which is exactly where a stray character
  // or a leftover "[YOUR-PASSWORD]" placeholder was slipping in during manual setup).
  // If you ever move off that integration, add `DATABASE_URL` / `DIRECT_URL` back as
  // plain environment variables and swap these two names back — see DEPLOYMENT.md,
  // which documents both paths.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Entity {
  id           String        @id @default(cuid())
  name         String
  /// The currency this entity reports in — every ReconciliationResult/AccountSummary
  /// the reporting layer produces for this entity's instruments is grouped against
  /// currencies relative to this one. Doesn't itself trigger any conversion; see the
  /// scope note in src/lib/accounting/types.ts and the ASC 830-20 remeasurement engine
  /// in fxTranslation.ts for the one place actual currency conversion happens.
  reportingCurrency String   @default("USD")
  /// v0.33.0 — the filer's own identification for tax/compliance filings this entity
  /// generates on its stakeholders' behalf (Form 3921's "Transferor corporation" name/
  /// address/EIN box). NULLABLE: every entity created before this feature existed has
  /// neither, and plenty of entities will never need to produce a real filing at all —
  /// see optionTaxCompliance.ts, which refuses to assemble a Form 3921 (rather than
  /// silently leaving the EIN blank on a real tax document) when either is missing.
  employerIdentificationNumber String?
  address                      String?
  createdAt    DateTime      @default(now())
  stakeholders Stakeholder[]
  instruments  Instrument[]
  documents    Document[]
  /// v0.33.0 — see TaxFilingRecord's own doc comment.
  taxFilingRecords TaxFilingRecord[]
  /// v0.36.0 — see BoardConsent's own doc comment.
  boardConsents    BoardConsent[]
  /// Who can see/edit this entity's data at all, and at what role — see User/
  /// EntityAccess below and src/lib/auth/access.ts. An Entity with no EntityAccess
  /// rows is unreachable by anyone through the app (not even its creator) — every
  /// entity-creation code path must create the creator's OWNER row in the same
  /// transaction as the Entity itself, never as a separate step.
  access       EntityAccess[]
  /// Reverse side of User.defaultEntityId above — everyone who currently has THIS
  /// entity set as their default. Not rendered anywhere; exists only because Prisma
  /// requires both sides of a relation to be declared.
  defaultForUsers User[] @relation("UserDefaultEntity")
  /// v0.38.0 — see PerformanceCondition's own doc comment.
  performanceConditions PerformanceCondition[]
  /// v0.47.0 — see ContractAnalysis's own doc comment.
  contractAnalyses ContractAnalysis[]
}

/// One real person who can log into this app — as distinct from a Stakeholder, which
/// is a party to an instrument (an investor, an employee receiving options, a lender)
/// and has no login of their own. A User and a Stakeholder can refer to the same real
/// person without any relation between these two models; nothing in this schema links
/// them, and nothing needs to.
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  /// "scrypt:<saltHex>:<hashHex>" — see src/lib/auth/passwordHashing.ts. Never a plain
  /// password, and never anything this schema or the app could reverse.
  passwordHash String
  /// "Log out everywhere" counter (v0.20.0) — see src/lib/auth/session.ts's module doc
  /// comment for the full design. Every session token issued at login carries the
  /// `sessionVersion` that was current at the time; bumping this column (POST
  /// /api/auth/logout-everywhere) instantly invalidates every OLDER token, since none
  /// of them carry the new number, while a freshly-issued token (also returned by that
  /// same endpoint) keeps the calling device logged in. Checked in
  /// authGuard.ts's resolveUserFromToken, which already loads this row on every
  /// authenticated request — not in src/middleware.ts, which stays database-free.
  sessionVersion Int          @default(0)
  createdAt    DateTime       @default(now())
  access       EntityAccess[]
  /// v0.21.0 — "default entity" (requested directly by a user who kept landing on
  /// NavBar's "Pass ?entityId=..." message after clicking "New transactions" with no
  /// entity in the current URL — see NavBar.tsx's doc comment, which flagged exactly
  /// this gap before it was reported). NULLABLE: a brand-new user has none yet, and
  /// `POST /api/entities` sets this automatically the first time a user creates an
  /// entity (see that route) so the common single-entity user never has to take an
  /// extra step; a user managing several entities can change it from the home page's
  /// "Set as default" control (EntityRowActions.tsx). `onDelete: SetNull` deliberately
  /// (not the RESTRICT every other FK in this schema uses) — losing your default
  /// because the entity itself was deleted should degrade gracefully back to "no
  /// default," never block the entity's deletion.
  defaultEntityId String?
  defaultEntity   Entity?        @relation("UserDefaultEntity", fields: [defaultEntityId], references: [id], onDelete: SetNull)
  /// Reverse sides of the v0.19.0 audit-trail attribution columns — see
  /// InstrumentTermVersion.createdByUserId and Correction.createdByUserId. Named
  /// relations (not Prisma's default inferred name) purely for clarity, since a plain
  /// unnamed `Correction[]`/`InstrumentTermVersion[]` here would read ambiguously next
  /// to `access` above.
  createdTermVersions InstrumentTermVersion[] @relation("TermVersionCreatedBy")
  createdCorrections  Correction[]            @relation("CorrectionCreatedBy")
  approvedAmortizationSchedules AmortizationScheduleApproval[] @relation("AmortizationApprovedBy")
  /// v0.33.0 — reverse sides of the option tax/compliance feature's attribution
  /// columns, same "who recorded this, not just what and when" reasoning as
  /// InstrumentTermVersion.createdByUserId above.
  recordedOptionExercises   OptionExerciseEvent[]   @relation("OptionExerciseRecordedBy")
  recordedShareDispositions ShareDispositionEvent[] @relation("ShareDispositionRecordedBy")
  /// v0.46.0 — reverse side of InstrumentForfeitureEvent.recordedByUserId.
  recordedInstrumentForfeitures InstrumentForfeitureEvent[] @relation("InstrumentForfeitureRecordedBy")
  /// v0.47.0 — reverse sides of the document library's attribution columns.
  uploadedDocuments Document[] @relation("DocumentUploadedBy")
  requestedContractAnalyses ContractAnalysis[] @relation("ContractAnalysisRequestedBy")
  filedTaxFilingRecords     TaxFilingRecord[]       @relation("TaxFilingRecordFiledBy")
  /// v0.35.0 — reverse side of the stakeholder portal's invite system (see
  /// PortalInvite below): which admin generated a given invite, for the same
  /// "who did this, not just what and when" audit reasoning as every other
  /// createdByUserId/recordedByUserId column in this schema.
  createdPortalInvites PortalInvite[] @relation("PortalInviteCreatedBy")
  /// v0.36.0 — see BoardConsent's own doc comment.
  createdBoardConsents BoardConsent[]
  /// v0.38.0 — reverse side of PerformanceConditionAssessment.createdByUserId, same
  /// "who did this, not just what and when" reasoning as every other
  /// createdByUserId/recordedByUserId column in this schema.
  createdPerformanceConditionAssessments PerformanceConditionAssessment[] @relation("PerformanceConditionAssessmentCreatedBy")
}

enum EntityRole {
  /// Full read/write on this entity's data, AND can grant/revoke other users' access
  /// to it (see POST /api/auth/users). Exactly one OWNER always exists per entity —
  /// whoever created it — though more than one is allowed (e.g. a second partner).
  OWNER
  /// Full read/write on this entity's data, but cannot grant or revoke access for
  /// anyone else. For a bookkeeper or associate who does real work on the entity but
  /// shouldn't be deciding who else gets in.
  EDITOR
  /// Read-only — for an external reviewer, auditor, or client checking numbers without
  /// being able to change anything.
  VIEWER
}

/// The multi-tenancy join table: which users can reach which entities, and at what
/// role. See src/lib/auth/access.ts for the role-ranking logic every entity-scoped
/// route/page checks against before reading or writing. A user with no EntityAccess
/// row for an entity gets a 404, not a 403 — this app doesn't confirm to an
/// unauthorized user that an entity ID even exists (see access.ts's doc comment).
model EntityAccess {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  entityId  String
  entity    Entity     @relation(fields: [entityId], references: [id])
  role      EntityRole
  createdAt DateTime   @default(now())

  @@unique([userId, entityId])
  @@index([entityId])
}

enum StakeholderType {
  INVESTOR
  DEBT_HOLDER
  EMPLOYEE
  ADVISOR
  ENTITY_HOLDER // another company acting as an investor or lender
}

/// v0.44.0 — "Investor Contacts" page (George, verbatim: wants investor type
/// [individual, institution] tracked alongside a contact/point person, mailing
/// address, email, and phone). Deliberately its own enum rather than reusing/extending
/// StakeholderType: StakeholderType answers "what kind of claim does this person/entity
/// hold on the company" (an equity investor vs. a lender vs. an employee), while
/// InvestorType answers an orthogonal question — "is the investor itself a natural
/// person or an organization" — which matters because an INSTITUTION needs a named
/// human point of contact (Stakeholder.contactName below) that's distinct from the
/// institution's own name, while an INDIVIDUAL investor IS their own contact.
enum InvestorType {
  INDIVIDUAL
  INSTITUTION
}

model Stakeholder {
  id          String          @id @default(cuid())
  entityId    String
  entity      Entity          @relation(fields: [entityId], references: [id])
  type        StakeholderType
  name        String
  email       String?
  phone       String?
  address     String?
  /// v0.44.0 — NULLABLE, and only meaningful for an INVESTOR/ENTITY_HOLDER stakeholder
  /// (see InvestorType's own doc comment above) — left unset for EMPLOYEE/ADVISOR/
  /// DEBT_HOLDER rows and for anything recorded before this existed. Surfaced on the
  /// "Investor Contacts" page (src/app/investors/contacts/page.tsx).
  investorType InvestorType?
  /// v0.44.0 — the point-of-contact PERSON's name for this investor, shown on the
  /// "Investor Contacts" page. For an INSTITUTION this is genuinely a different value
  /// from `name` above (e.g. `name` = "Acme Ventures LLC", `contactName` = "Jane Doe,
  /// Managing Partner"); for an INDIVIDUAL investor it's expected to just repeat `name`
  /// (they're their own point of contact) — the UI defaults it that way but doesn't
  /// enforce it at the database level, since nothing here actually depends on the two
  /// being equal. NULLABLE for the same reasons as investorType above; the Investor
  /// Contacts page falls back to showing `name` itself when this is unset, so that
  /// page never renders a blank "point of contact" for an existing record.
  contactName String?
  /// v0.33.0 — SSN (individual) or EIN (an ADVISOR/ENTITY_HOLDER that's itself a
  /// business) for tax/compliance filings this platform generates on this
  /// stakeholder's behalf (Form 3921's recipient TIN box). NULLABLE for every
  /// stakeholder recorded before this existed, and for anyone who simply never needs
  /// a real tax filing produced.
  ///
  /// SECURITY — READ BEFORE DEPLOYING: this column is a government tax-ID number
  /// stored as PLAIN TEXT, the same way every other free-text field on this model is.
  /// That is NOT an acceptable production posture for an SSN. Before this field is
  /// actually populated with real data outside a sandbox/demo, add field-level
  /// encryption at rest (e.g. pgcrypto's pgp_sym_encrypt/decrypt, or application-layer
  /// encryption before the value ever reaches Prisma) and restrict which
  /// roles/endpoints can read it back in full (a report or UI that only needs to
  /// confirm "a TIN is on file" should never fetch the plaintext value at all). This
  /// migration deliberately does NOT implement that — it's a deployment/infra decision
  /// (which KMS, which access-control layer) that belongs to whoever operates the real
  /// database, not something to guess at here.
  taxIdNumber String?
  instruments Instrument[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  /// v0.35.0 — reverse sides of the stakeholder self-service portal (see
  /// StakeholderUser/StakeholderAccess/PortalInvite below). A Stakeholder can have at
  /// most one live PortalInvite outstanding in practice (the invite route reuses an
  /// unexpired/unused one rather than piling up duplicates — see that route's doc
  /// comment) but this is modeled as a list since nothing in the schema itself needs
  /// to enforce that; `portalAccess` is empty until someone actually accepts an invite.
  portalAccess  StakeholderAccess[]
  portalInvites PortalInvite[]
  /// v0.47.0 — see Document.stakeholderId's own doc comment. Queried directly by
  /// GET /api/stakeholders/:id/documents (StakeholderDocumentsPanel.tsx's side panel).
  documents     Document[]

  @@index([entityId])
}

/// v0.35.0 — stakeholder/investor self-service portal (George, verbatim: "definitely
/// want to build out the stakeholder/investor self service portal"). v1 SCOPE, locked
/// in before building: VIEW-ONLY (holdings, vesting, exercise/disposition history,
/// documents — no exercise requests, no e-signature, no tax elections in this pass);
/// every StakeholderType gets access (not employees only); invites are an
/// admin-generated one-time link the admin copies and sends however they choose — no
/// email vendor wired up (Communications page is still a placeholder, see that file).
///
/// WHY A SEPARATE IDENTITY MODEL FROM `User`, NOT A PASSWORD DIRECTLY ON
/// `Stakeholder`: a `Stakeholder` row is scoped to exactly one `Entity` (design note
/// at the top of this file — multi-tenancy is a join table, not a tenantId column), but
/// the same real person can easily BE a stakeholder of more than one entity on this
/// platform — an investor with stakes in several portfolio companies, an advisor to two
/// different startups, a founder who's also an angel investor elsewhere. Putting
/// login credentials directly on `Stakeholder` would force that person into a separate
/// login per company, which is exactly the wrong UX for a "log in once, see everything
/// you hold" portal. So this mirrors the EXACT same pattern this schema already uses
/// for admin access — `User` (one identity) + `EntityAccess` (a join table granting
/// that identity access to a specific entity) — as `StakeholderUser` (one identity,
/// matched by email) + `StakeholderAccess` (a join table granting that identity
/// visibility into one specific `Stakeholder` record, i.e. one specific entity's cap
/// table entry for them). This is a fully separate, parallel identity system: a
/// `StakeholderUser` can never log into the admin side, and a `User` can never log
/// into the portal, even if they happen to share an email address — see
/// src/lib/auth/portalSession.ts's doc comment for why the session tokens themselves
/// are also a completely separate type, not a reused `SessionPayload`.
model StakeholderUser {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Same "scrypt:<saltHex>:<hashHex>" format as User.passwordHash (reuses
  /// passwordHashing.ts directly — it was already fully generic, not User-specific).
  /// NULLABLE: a StakeholderUser row can exist BEFORE a password is set — created the
  /// moment an admin first invites that email, so a second invite (a different
  /// stakeholder record, same person, e.g. a second portfolio company) can find and
  /// reuse the same identity instead of erroring on a duplicate email. The
  /// accept-invite flow requires setting a password before it will treat the account
  /// as active if this is still null; see POST /api/portal/accept-invite.
  passwordHash   String?
  /// "Log out everywhere" counter — identical mechanism to User.sessionVersion, see
  /// that field's doc comment. Independent counter: revoking a person's ADMIN sessions
  /// (if they happen to also have a User account) never touches their PORTAL sessions
  /// and vice versa, since these are genuinely separate identities.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  access         StakeholderAccess[]
  invitesAccepted PortalInvite[] @relation("PortalInviteAcceptedBy")
}

/// The portal's multi-tenancy join table — see StakeholderUser's doc comment for why
/// this exists as a separate table rather than a direct FK on Stakeholder. Created
/// once, at the moment an invite is ACCEPTED (never at invite-creation time — an
/// unaccepted invite grants nothing yet, see PortalInvite below).
model StakeholderAccess {
  id                String          @id @default(cuid())
  stakeholderUserId String
  stakeholderUser   StakeholderUser @relation(fields: [stakeholderUserId], references: [id])
  stakeholderId     String
  stakeholder       Stakeholder     @relation(fields: [stakeholderId], references: [id])
  createdAt         DateTime        @default(now())
  /// v0.36.0 — when true, this specific access grant sees the ENTITY'S FULL cap table
  /// (read-only) on the portal instead of just this one Stakeholder record's own
  /// holdings — the "board member portal" gap: a board observer needs to see the
  /// whole ownership picture, not one row of it. Deliberately a flag on the ACCESS
  /// GRANT, not a new StakeholderType or a role on StakeholderUser: (a) it keeps the
  /// blast radius to exactly the portal's own rendering logic, rather than touching
  /// every place in this codebase that already branches on StakeholderType
  /// (EMPLOYEE/INVESTOR/DEBT_HOLDER/ADVISOR/ENTITY_HOLDER); and (b) it's naturally
  /// per-entity, matching the fact that StakeholderAccess itself already is — the
  /// same person could be an ordinary stakeholder in one entity and a board observer
  /// in another. Set at invite-acceptance time from PortalInvite.grantsBoardObserverAccess
  /// below; never changed after that except by revoking and re-inviting.
  boardObserver     Boolean         @default(false)

  @@unique([stakeholderUserId, stakeholderId])
  @@index([stakeholderId])
}

/// A single-use, expiring link an admin generates for one specific Stakeholder row
/// (POST /api/stakeholders/[id]/portal-invite, requires EDITOR — see that route) and
/// then copies and sends to that person however they choose (no email vendor exists
/// yet — see communications/page.tsx). Only the HASH of the actual token is stored
/// (`tokenHash`, same reasoning as password storage: if this table's contents ever
/// leaked, a stored raw token would let anyone immediately claim that stakeholder's
/// portal access, whereas a hash is useless without the original token) — the raw
/// token is shown to the inviting admin exactly once, in the API response, and never
/// persisted anywhere in plaintext.
model PortalInvite {
  id              String    @id @default(cuid())
  stakeholderId   String
  stakeholder     Stakeholder @relation(fields: [stakeholderId], references: [id])
  /// SHA-256 hex of the raw token — see portalInvite.ts. Not scrypt: this is a
  /// high-entropy, single-use random secret rather than a low-entropy human-chosen
  /// password, so a fast cryptographic hash is the right (and standard) tool here, not
  /// a slow KDF meant to resist brute-forcing a small guess space.
  tokenHash       String    @unique
  createdByUserId String
  createdByUser   User      @relation("PortalInviteCreatedBy", fields: [createdByUserId], references: [id])
  expiresAt       DateTime
  /// NULL until accepted. Checked alongside expiresAt by POST /api/portal/accept-invite
  /// — a used-but-unexpired token must still be rejected (one-time use, not "use until
  /// expiry").
  usedAt            DateTime?
  acceptedByUserId  String?
  acceptedByUser    StakeholderUser? @relation("PortalInviteAcceptedBy", fields: [acceptedByUserId], references: [id])
  createdAt         DateTime  @default(now())
  /// v0.36.0 — carried onto the resulting StakeholderAccess.boardObserver at
  /// acceptance time (see that field's doc comment). Set by the admin when generating
  /// the invite link (a new checkbox on InvitePortalAccessButton), not by the
  /// stakeholder accepting it — a board-observer grant is a decision the ADMIN makes
  /// about who gets full-cap-table visibility, never a self-service upgrade.
  grantsBoardObserverAccess Boolean @default(false)

  @@index([stakeholderId])
}

enum InstrumentType {
  STOCK_OPTION
  RSU
  SAR
  WARRANT
  CONVERTIBLE_NOTE
  TERM_LOAN
  REVOLVER
  PIK_NOTE
  PREFERRED_STOCK
  COMMON_STOCK
  /// Early-exercised stock options and restricted stock purchased subject to a
  /// vesting-based repurchase right — see src/lib/accounting/restrictedStock.ts. Added
  /// as its own type (v0.16.0) rather than a flag on STOCK_OPTION/COMMON_STOCK because
  /// its balance-sheet presentation genuinely differs: cash received for unvested
  /// shares sits in a liability (not issued equity) until the repurchase right lapses.
  RESTRICTED_STOCK
}

enum InstrumentStatus {
  ACTIVE
  CANCELLED
  CONVERTED
  EXERCISED
  REPAID
  EXTINGUISHED
}

model Instrument {
  id              String                   @id @default(cuid())
  entityId        String
  entity          Entity                   @relation(fields: [entityId], references: [id])
  stakeholderId   String
  stakeholder     Stakeholder              @relation(fields: [stakeholderId], references: [id])
  type            InstrumentType
  status          InstrumentStatus         @default(ACTIVE)
  issueDate       DateTime
  /// The currency this instrument's own face amounts and schedule are denominated in
  /// (e.g. "EUR" for a euro-denominated term loan). Independent of the owning Entity's
  /// reportingCurrency — a foreign-currency instrument is exactly the case
  /// fxTranslation.ts's remeasurement engine exists for. Defaults to USD so existing
  /// single-currency clients never have to set this.
  currency        String                   @default("USD")
  termVersions    InstrumentTermVersion[]
  scheduleEntries ScheduleEntry[]
  journalEntries  JournalEntry[]
  corrections     Correction[]
  documents       Document[]
  /// Approved, full-service-period monthly amortization tables — see
  /// AmortizationScheduleApproval's doc comment. Usually 0 or 1 CURRENT approval per
  /// instrument (more than one only when a modification triggered a re-approval —
  /// older ones stay for history, never deleted).
  amortizationApprovals AmortizationScheduleApproval[]
  /// v0.33.0 — real exercise events for a STOCK_OPTION instrument (date, quantity,
  /// exercise price, and the FMV at exercise a tax filing needs) — see
  /// OptionExerciseEvent's own doc comment for why this is a separate append-only
  /// event log rather than another InstrumentTermVersion.
  exerciseEvents  OptionExerciseEvent[]
  /// v0.46.0 — real forfeiture/expiration events (a grant or vested-but-unexercised
  /// option that lapsed) — see InstrumentForfeitureEvent's own doc comment.
  forfeitureEvents InstrumentForfeitureEvent[]
  /// v0.33.0 — reverse side of TaxFilingRecord.instrumentId, used only by
  /// ELECTION_83B_DEADLINE rows (see that field's doc comment) — an 83(b) deadline
  /// traces to the grant/instrument itself, not to an OptionExerciseEvent.
  taxFilingRecords TaxFilingRecord[]
  /// v0.36.0 — see BoardConsentInstrument's own doc comment.
  boardConsentLinks BoardConsentInstrument[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([entityId])
  @@index([stakeholderId])
}

/// Append-only log of an instrument's terms over time. See modificationEngine.ts
/// (InstrumentTimeline) — this table is that class's persistence, nothing more.
/// Rows are only ever inserted, in increasing `effectiveDate` order, never updated.
model InstrumentTermVersion {
  id            String     @id @default(cuid())
  instrumentId  String
  instrument    Instrument @relation(fields: [instrumentId], references: [id])
  effectiveDate DateTime
  label         String
  /// Type-specific terms (quantity, strike, vesting tranches, principal, rate, ...).
  /// JSON rather than columns because each InstrumentType has a different shape, and
  /// new shapes will be added after launch — see design note #1 at the top of this file.
  terms         Json
  /// Which User recorded this version — added in v0.19.0 for the compliance/audit-
  /// trail report (src/lib/accounting/auditTrail.ts), which needs "who," not just
  /// "what and when." NULLABLE, permanently, for two reasons: every row written before
  /// this column existed has no value to backfill (there was nothing to derive it
  /// from), and a direct-SQL insert (db/seed.sql, or a support fix via Supabase's Table
  /// Editor) still won't set it. No `onDelete` behavior is specified deliberately —
  /// see the identical note on Correction.createdByUserId below.
  createdByUserId String?
  createdByUser   User?      @relation("TermVersionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt     DateTime   @default(now())
  /// Reverse side of AmortizationScheduleApproval.sourceTermVersionId below — every
  /// approved amortization table computed FROM this specific version of the terms.
  amortizationApprovals AmortizationScheduleApproval[]
  /// v0.38.0 — links this term version to a shared PerformanceCondition (see that
  /// model's doc comment) instead of carrying its own inline `probabilityAssessments`
  /// in `terms`. NULLABLE and OPTIONAL: a STOCK_OPTION performance-condition grant can
  /// still go the old way (its own `probabilityAssessments` array inside `terms`,
  /// unchanged) — this is an opt-in for grants that actually share a real condition
  /// with other grants. Only meaningful when the underlying instrument's latest terms
  /// have `conditionType: "performance"`; nothing enforces that at the schema level
  /// (same reason `terms` itself is untyped JSON — see the design note at the top of
  /// this file), so `resolvePerformanceConditionProbabilities` (dispatch.ts) is what
  /// actually reads this, not a database constraint.
  performanceConditionId String?
  performanceCondition   PerformanceCondition? @relation(fields: [performanceConditionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([instrumentId, effectiveDate])
  @@index([performanceConditionId])
}

/// Performance-condition tracking (v0.38.0) — George's request: several grants can
/// vest on the SAME real-world performance condition (e.g. every officer's award tied
/// to the same FY26 EBITDA target), and the probability of THAT condition being met —
/// not each grant's own separately-maintained copy of an assessment — is what should
/// drive whether expense amortizes for every grant tied to it. Before this,
/// `probabilityAssessments` lived entirely inside each grant's own `terms` JSON (see
/// StockOptionPerformanceConditionTerms in dispatch.ts) with no way to update it once
/// for several grants sharing the same real condition. This model is that shared
/// identity; a grant opts in via InstrumentTermVersion.performanceConditionId above
/// (nullable — a grant can still carry its own inline `probabilityAssessments`
/// instead, unchanged, for backward compatibility and for anyone who doesn't need
/// cross-grant tracking).
///
/// DELIBERATELY SCOPED TO PERFORMANCE CONDITIONS ONLY, NOT MARKET CONDITIONS: ASC
/// 718-10-25 prices a market condition's probability of achievement INTO its grant-
/// date fair value (the Monte Carlo/lattice valuation) — expense recognizes on a fixed
/// schedule with NO reversal even if the hurdle is ultimately missed (see
/// MarketConditionGrantForm's hint in TypeForms.tsx). A market-condition grant's
/// `conditionCode`/`conditionDescription`/`expectedTimeToMeetMarketCondition` stay
/// plain informational text inside its own `terms` JSON for that reason, not a
/// relation to this model — there is deliberately no MarketCondition equivalent here.
model PerformanceCondition {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Short label, e.g. "Apr 2026 EBITDA Perf" — see suggestConditionCode in
  /// TypeForms.tsx for the suggested format this mirrors. Unique per entity so the
  /// wizard's "link to an existing condition" picker has something unambiguous to
  /// match against; two DIFFERENT entities may reuse the same code freely.
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assessments  PerformanceConditionAssessment[]
  termVersions InstrumentTermVersion[]

  @@unique([entityId, code])
}

/// One dated probability call against a PerformanceCondition — "as of this date, is
/// the condition probable of being met." APPEND-ONLY, same reasoning as
/// AmortizationScheduleApproval and Correction elsewhere in this schema: a call that
/// turns out to be wrong is superseded by a NEW row with a later `effectiveDate`,
/// never edited or deleted in place, so the history of what was believed and when
/// survives audit. `resolvePerformanceConditionProbabilities` (dispatch.ts) reads
/// this back out to answer "what was believed as of THIS period's end" for every
/// grant tied to this condition, translating this date-keyed history into the
/// positional, one-entry-per-period array the engine itself has always consumed (see
/// getScheduleBuilder's STOCK_OPTION/performance branch) — the engine's own
/// `buildPerformanceConditionSchedule` function did not need to change at all.
model PerformanceConditionAssessment {
  id                     String               @id @default(cuid())
  performanceConditionId String
  performanceCondition   PerformanceCondition @relation(fields: [performanceConditionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  effectiveDate          DateTime
  probable               Boolean
  note                   String?
  /// Nullable for the same reason InstrumentTermVersion.createdByUserId is — a
  /// direct-SQL-inserted row has nothing to set this from.
  createdByUserId String?
  createdByUser   User?    @relation("PerformanceConditionAssessmentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([performanceConditionId, effectiveDate])
}

/// The FULL, end-to-end (grant date through final vest/service date), MONTHLY
/// amortization table for one instrument — v0.22.0, built directly for the request:
/// "after a user inputs valid terms for a stock option, the system should compute a
/// full amortization table (by month) over the service period that can be previewed
/// by the user. once approved, that amortization table should be saved to the
/// database and associated with the award and investor, while also aggregated with
/// all other stock options of the same type."
///
/// DELIBERATELY SEPARATE FROM ScheduleEntry (not a replacement for it): ScheduleEntry
/// + JournalEntry (via the close workflow — see closeInstrument.ts) represent what's
/// ACTUALLY BEEN RECOGNIZED AND BOOKED as of a real date — never further out than
/// today, since booking expense for service not yet rendered would misstate the
/// financials. An AmortizationScheduleApproval is the opposite: the FULL projected
/// plan for the entire service period, approved once as the record of "this is the
/// amortization table for this grant" (the same kind of forward-looking schedule a
/// cap table tool or an equity plan administrator produces at grant time for
/// planning/disclosure purposes), independent of how much of it has actually been
/// booked to the GL yet. Associated with the INVESTOR implicitly through
/// Instrument.stakeholderId — no separate stakeholder FK needed here, the same way
/// ScheduleEntry doesn't carry one either.
///
/// APPEND-ONLY, same pattern as InstrumentTermVersion/Correction: approving a NEW
/// schedule (e.g. after a modification changes the terms) never edits or deletes a
/// prior approval — it creates a new one. `sourceTermVersionId` is what lets the UI
/// detect a STALE approval (one computed from an older term version than the
/// instrument's current one) and prompt for re-approval, rather than silently
/// treating outdated projections as current.
model AmortizationScheduleApproval {
  id                  String                 @id @default(cuid())
  instrumentId        String
  instrument          Instrument             @relation(fields: [instrumentId], references: [id])
  sourceTermVersionId String
  sourceTermVersion   InstrumentTermVersion  @relation(fields: [sourceTermVersionId], references: [id])
  /// Nullable for the same reason InstrumentTermVersion.createdByUserId is — a
  /// direct-SQL-inserted row (a support fix, a seed) has nothing to set this from.
  approvedByUserId    String?
  approvedByUser      User?                  @relation("AmortizationApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt          DateTime               @default(now())
  rows                AmortizationScheduleRow[]

  @@index([instrumentId])
}

model AmortizationScheduleRow {
  id            String                       @id @default(cuid())
  approvalId    String
  approval      AmortizationScheduleApproval @relation(fields: [approvalId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  label         String
  amount        Decimal                      @db.Decimal(18, 4)
  /// Cumulative amount recognized as of this row's periodEnd, for THIS instrument
  /// alone — mirrors ScheduleEntry.endingBalance's meaning.
  endingBalance Decimal?                     @db.Decimal(18, 4)
  currency      String                       @default("USD")

  @@index([approvalId, periodEnd])
}

/// One computed row from the accounting engine (vesting expense, interest expense,
/// a fair-value remeasurement, ...). Written by the engine, read by every reporting
/// feature — this table is the join point between src/lib/accounting and the UI.
///
/// Corrections (see the Correction model below) never delete or edit a row here —
/// a restated period's OLD row gets `supersededByCorrectionId` set, and the NEW
/// (corrected) row is inserted with `createdByCorrectionId` pointing at the same
/// Correction. A report should filter `supersededByCorrectionId: null` for the current
/// view; the full, unfiltered table is the ASC 250 audit trail of what was originally
/// reported and what changed.
model ScheduleEntry {
  id                     String      @id @default(cuid())
  instrumentId           String
  instrument             Instrument  @relation(fields: [instrumentId], references: [id])
  periodStart            DateTime
  periodEnd              DateTime
  label                  String
  amount                 Decimal     @db.Decimal(18, 4)
  endingBalance          Decimal?    @db.Decimal(18, 4)
  /// The currency `amount`/`endingBalance` are denominated in — mirrors
  /// ScheduleRow.currency in src/lib/accounting/types.ts. Defaults to USD; for an
  /// FX-remeasurement row (fxTranslation.ts) this is the REPORTING currency, since
  /// that's what the row's amount/endingBalance are actually expressed in, not the
  /// instrument's own face currency.
  currency               String      @default("USD")
  ascReference           String?
  /// Which InstrumentTermVersion.label produced this row — carries the modification
  /// audit trail through to the schedule itself, matching modificationEngine.ts's
  /// `termVersionLabel` metadata field.
  termVersionLabel       String?
  meta                   Json?
  supersededByCorrectionId String?
  supersededByCorrection Correction? @relation("ScheduleSuperseded", fields: [supersededByCorrectionId], references: [id])
  createdByCorrectionId  String?
  createdByCorrection    Correction? @relation("ScheduleCreated", fields: [createdByCorrectionId], references: [id])
  createdAt              DateTime    @default(now())

  @@index([instrumentId, periodEnd])
}

/// See the audit-trail note on ScheduleEntry above — the same supersede/create pattern
/// applies here for restated journal entries.
model JournalEntry {
  id                     String        @id @default(cuid())
  instrumentId           String?
  instrument             Instrument?   @relation(fields: [instrumentId], references: [id])
  date                   DateTime
  description            String
  ascReference           String?
  /// Mirrors JournalEntry.currency in src/lib/accounting/types.ts — a single entry is
  /// always one currency (see that field's doc comment for why). Defaults to USD.
  currency               String        @default("USD")
  lines                  JournalLine[]
  supersededByCorrectionId String?
  supersededByCorrection Correction?   @relation("JournalSuperseded", fields: [supersededByCorrectionId], references: [id])
  createdByCorrectionId  String?
  createdByCorrection    Correction?   @relation("JournalCreated", fields: [createdByCorrectionId], references: [id])
  createdAt              DateTime      @default(now())

  @@index([instrumentId, date])
}

enum CorrectionElection {
  PROSPECTIVE
  RETROSPECTIVE
}

/// One record per error correction, per correctionService.ts. `previewSnapshot` stores
/// exactly what was shown to the person who made the materiality call (the
/// CorrectionPreview from previewCorrection) — so "why was this booked this way" is
/// always answerable from the database, not just from application logs.
model Correction {
  id               String             @id @default(cuid())
  instrumentId     String
  instrument       Instrument         @relation(fields: [instrumentId], references: [id])
  discoveredDate   DateTime
  reason           String
  election         CorrectionElection
  previewSnapshot  Json
  scheduleSuperseded ScheduleEntry[]  @relation("ScheduleSuperseded")
  scheduleCreated    ScheduleEntry[]  @relation("ScheduleCreated")
  journalSuperseded  JournalEntry[]   @relation("JournalSuperseded")
  journalCreated     JournalEntry[]   @relation("JournalCreated")
  /// Who committed this correction — same v0.19.0 addition, same nullability
  /// reasoning, as InstrumentTermVersion.createdByUserId above. No `onDelete` behavior
  /// is specified on purpose: a Correction is a permanent accounting/audit record that
  /// must never disappear or fail to delete just because the user who happened to
  /// record it is later removed. The default (NoAction, enforced by the same "no user
  /// deletion flow exists yet" honest gap noted on EntityAccess) is acceptable for now;
  /// a real user-offboarding flow, whenever it's built, needs to null this out rather
  /// than delete the User row out from under a live foreign key.
  createdByUserId  String?
  createdByUser    User?              @relation("CorrectionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime           @default(now())

  @@index([instrumentId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  account        String
  debit          Decimal?     @db.Decimal(18, 4)
  credit         Decimal?     @db.Decimal(18, 4)
  memo           String?

  @@index([journalEntryId])
}

/// The document library (broadened v0.47.0 — see design note #3 at the top of this
/// file for why this used to be vendor-pointer-only and no longer is). A `Document` is
/// the logical record ("Jane Doe's Series A Stock Purchase Agreement"); its actual
/// file content lives on `DocumentVersion`, potentially more than one version over
/// time (a redline, a fully-executed copy).
model Document {
  id            String            @id @default(cuid())
  entityId      String
  entity        Entity            @relation(fields: [entityId], references: [id])
  instrumentId  String?
  instrument    Instrument?       @relation(fields: [instrumentId], references: [id])
  /// v0.47.0 — who this document is ABOUT, independent of whether it's also tied to
  /// one specific instrument. Most uploads (an option agreement, a stock purchase
  /// agreement, an NDA, a side letter) are naturally "this investor's paperwork" even
  /// when they also happen to reference a specific instrument — and some (a subscription
  /// agreement covering several instruments at once, a general correspondence) aren't
  /// tied to any one instrument at all. NULLABLE: a genuinely entity-wide document (a
  /// certificate of incorporation, a board policy) has neither this nor instrumentId
  /// set. This is what src/app/components/StakeholderDocumentsPanel.tsx queries by, and
  /// what makes "click an investor in the cap table, see everything on file for them"
  /// possible without depending on every document being instrument-scoped first.
  stakeholderId String?
  stakeholder   Stakeholder?      @relation(fields: [stakeholderId], references: [id])
  title         String
  /// v0.47.0 — free-text label ("Stock Purchase Agreement," "Option Agreement," "NDA,"
  /// "Side Letter") — deliberately NOT an enum. The set of document types a company
  /// actually retains varies too much across clients to pin down in advance, and
  /// getting this wrong would mean either a disruptive enum migration or an "OTHER"
  /// bucket that swallows everything — the same reasoning DocumentVersion.status below
  /// already uses for its own vendor-status vocabulary. NULLABLE — uncategorized is a
  /// normal state, not a data problem.
  category      String?
  /// v0.47.0 — who uploaded this, for the same audit-trail reasons
  /// InstrumentTermVersion.createdByUserId exists. NULLABLE for the same reason that
  /// field is — a direct-SQL-inserted row has nothing to set this from.
  uploadedByUserId String?
  uploadedByUser   User?          @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  /// v0.47.0 — ContractAnalysis links to a specific DocumentVersion, not to Document
  /// directly (see ContractAnalysis's own doc comment for why — an analysis is pinned
  /// to the exact version it actually read). There is deliberately no
  /// `Document.contractAnalyses` shortcut field: it would need its own denormalized FK
  /// with no real column backing it, and Prisma requires every relation to be backed by
  /// an actual foreign key on one concrete side. To get a document's analyses, go
  /// through its versions (`documentVersion.contractAnalyses` below) — see
  /// documents/page.tsx and the entity/stakeholder documents API routes for the query
  /// shape this actually uses in practice (nested under `versions`, then flattened back
  /// onto each document for the UI).
  versions      DocumentVersion[]
  createdAt     DateTime          @default(now())

  @@index([entityId])
  @@index([instrumentId])
  @@index([stakeholderId])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])
  versionNumber Int
  /// URL/reference into an e-signature/redlining VENDOR's storage (PandaDoc/DocuSign) —
  /// this is NOT the file itself, and this app never fetches or re-hosts whatever it
  /// points to. Exactly one of this and `storagePath` below is set on any given row —
  /// see `storagePath`'s own doc comment for the other case, which is now the more
  /// common one now that this app stores files itself.
  storageUrl    String?
  /// v0.47.0 — the object key of a file THIS APP uploaded to its own Supabase Storage
  /// bucket (see src/lib/storage/supabaseStorage.ts) — set instead of `storageUrl`
  /// whenever the file was uploaded directly through this app's own document library,
  /// rather than being a pointer to something living in PandaDoc/DocuSign. NEVER a
  /// public URL — the bucket is private, and every download goes through
  /// GET /api/documents/:documentId/download, which mints a short-lived signed URL on
  /// demand and redirects to it (see that route's own doc comment for why a signed URL
  /// is never stored directly on this row: it would go stale).
  storagePath   String?
  /// v0.47.0 — only meaningful alongside `storagePath` (a vendor pointer has no bytes
  /// for this app to know the size/type of). Shown in the document library UI and used
  /// to pick a sensible content-type when redirecting a download.
  mimeType      String?
  fileSizeBytes Int?
  /// draft | sent | redlined | signed | executed | retained — kept as a plain string rather than
  /// an enum since the exact vendor's status vocabulary is what actually governs this.
  status        String
  createdAt     DateTime @default(now())
  /// v0.47.0 — opposite side of ContractAnalysis.documentVersion below. Every AI
  /// analysis run is pinned to the specific version it actually read — see
  /// ContractAnalysis's own doc comment for why (a later corrected/re-signed version
  /// never silently reattributes an earlier analysis).
  contractAnalyses ContractAnalysis[]

  @@unique([documentId, versionNumber])
}

enum ContractAnalysisStatus {
  PENDING
  ANALYZING
  ANALYZED
  FAILED
}

/// v0.47.0 — George, verbatim: "allows users to upload a contract and the platform
/// identifies what it is (option, debt, etc.) and proposes accounting treatment and
/// memo justification for it (user should be able to select whether a memo draft is
/// required, since not all option grants need a memo)... identify the potential
/// accounting needs within a contract and reference ASC ... guidance to propose
/// initial and subsequent accounting treatment."
///
/// One row per analysis RUN against one specific `DocumentVersion` — not a field on
/// `Document`/`DocumentVersion` themselves, because re-running the analysis (a better
/// prompt later, a corrected upload) should never destroy the previous attempt, and a
/// single uploaded contract can reasonably be analyzed more than once. `documentVersionId`
/// (not `documentId`) is the FK specifically because the file bytes an analysis actually
/// read are pinned to one version — if someone uploads a corrected/re-signed version
/// later, the earlier analysis stays truthfully attached to the version it was actually
/// run against, not silently reattributed to whatever the "current" version becomes.
///
/// THIS IS AN AI-GENERATED PROPOSAL, NOT AN ACCOUNTING DETERMINATION — every field below
/// (identifiedInstrumentType, ascReferences, initialTreatment, subsequentTreatment,
/// memoDraft) is the Claude API's read of the uploaded document (see
/// src/lib/ai/anthropicClient.ts and contractAnalysisPrompt.ts), surfaced for a
/// qualified accountant to review, correct, and take responsibility for — never
/// auto-applied anywhere else in this app (it does NOT create an Instrument, a
/// JournalEntry, or anything else on its own). See the UI's own disclaimer text
/// (src/app/documents/[id]/analysis/page.tsx) for the exact language shown to the user
/// every time a result is displayed.
///
/// `memoRequested` is the user's own checkbox choice AT UPLOAD TIME ("not all option
/// grants need a memo") — when false, `memoDraft` is always left null rather than
/// generated-but-hidden, both to avoid the API cost of generating text nobody asked for
/// and because a memo draft that exists but is never shown is exactly the kind of
/// silent, unused state this codebase's other "honest, not fake" features (see
/// communications/page.tsx, InvestorContactsTable.tsx's mailto rationale) avoid on
/// principle.
model ContractAnalysis {
  id                 String                 @id @default(cuid())
  documentVersionId  String
  documentVersion    DocumentVersion        @relation(fields: [documentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Denormalized off documentVersion->document->entity purely so every query that
  /// scopes by entity (access control, the document library list) doesn't need a
  /// three-table join just to filter — same reasoning as other denormalized entityId
  /// columns in this schema (e.g. this exact pattern doesn't appear elsewhere today,
  /// but the access-control posture it enables mirrors requirePageEntityAccess's
  /// existing entityId-first checks everywhere else).
  entityId           String
  entity             Entity                 @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memoRequested      Boolean                @default(false)
  status             ContractAnalysisStatus @default(PENDING)
  /// The model's best guess at what kind of instrument this is — deliberately a free
  /// string, NOT InstrumentType. A contract can be something InstrumentType has no
  /// value for at all (an employment agreement, an NDA, a SAFE pre-conversion), and
  /// forcing the model's answer into the existing enum would either lose that
  /// information or require constantly widening InstrumentType for document
  /// classification concerns that have nothing to do with what it exists for (the cap
  /// table's own instrument records).
  identifiedInstrumentType String?
  /// "high" | "medium" | "low" — the model's own stated confidence in
  /// identifiedInstrumentType, surfaced so a reviewer knows when to look harder rather
  /// than take the classification at face value.
  confidence         String?
  summary            String?
  /// Free-form JSON of whatever key terms the model extracted (grant date, quantity,
  /// strike price, principal, interest rate, maturity, conversion features, etc.) —
  /// deliberately untyped, same reasoning as Instrument.terms: what's relevant varies
  /// entirely by what kind of contract this turned out to be, and this field is
  /// display-only (see contractAnalysisPrompt.ts's validation — never fed into the
  /// accounting engine).
  keyTerms           Json?
  /// Array of `{ reference: string, relevance: string }` (e.g. { reference: "ASC
  /// 718-10-25", relevance: "..." }) — the specific ASC topic/subtopic citations the
  /// model's proposed treatment relies on, each paired with why it applies to this
  /// particular contract's terms rather than a bare citation list. See
  /// contractAnalysisPrompt.ts's validateContractAnalysisResult for the shape this is
  /// always normalized to before being persisted here.
  ascReferences      Json?
  initialTreatment   String?
  subsequentTreatment String?
  /// string[] — things the model flagged as needing a human's judgment call rather than
  /// asserting an answer (an ambiguous term, a possible embedded derivative that would
  /// need the bifurcation calculator, a missing exhibit) — see
  /// src/app/reports/embedded-derivative-bifurcation and beneficial-conversion-feature
  /// for the existing calculators a reviewer might be pointed toward from here.
  openQuestions      Json?
  /// Only ever populated when memoRequested is true — see this model's own doc comment.
  memoDraft          String?
  /// Populated only when status is FAILED — the reason the analysis didn't complete
  /// (a Claude API error, an unreadable/corrupt file, a file type this app can't yet
  /// extract text from), shown back to the user rather than a bare "something went
  /// wrong" per this codebase's error-handling convention elsewhere.
  errorMessage       String?
  requestedByUserId  String?
  requestedByUser    User?                  @relation("ContractAnalysisRequestedBy", fields: [requestedByUserId], references: [id])
  createdAt          DateTime               @default(now())
  analyzedAt         DateTime?

  @@index([documentVersionId])
  @@index([entityId])
}

/// v0.33.0 — stock option tax/compliance reporting (see src/lib/accounting/
/// optionTaxCompliance.ts). This is a real, append-only EVENT log — "on this date,
/// this many shares of this option were exercised, at this price, when FMV was this"
/// — deliberately NOT another InstrumentTermVersion. A term version describes the
/// GRANT's terms (which can be amended); an exercise is something that HAPPENED, once,
/// on a specific date, and a stock option is very often exercised in more than one
/// tranche over its life — modeling that as "the terms as of this date" would force an
/// awkward new term version for every partial exercise and give no natural place to
/// record per-exercise FMV (a term version's `terms` JSON describes the award, not a
/// point-in-time market observation). Every field here maps directly onto a box on IRS
/// Form 3921 — see `computeForm3921Data` in optionTaxCompliance.ts.
model OptionExerciseEvent {
  id             String     @id @default(cuid())
  instrumentId   String
  instrument     Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exerciseDate   DateTime
  quantityExercised            Decimal @db.Decimal(24, 6)
  exercisePricePerShare        Decimal @db.Decimal(24, 6)
  /// Fair market value per share ON THE EXERCISE DATE — the figure that determines the
  /// ISO bargain-element AMT preference (taxElections.ts's
  /// computeIsoExerciseAmtPreference) and Form 3921 Box 4. NOT the same figure as the
  /// grant's `grantDateFairValuePerUnit` (an ASC 718 valuation input, as of grant, not
  /// exercise) — a genuinely different number recorded at a genuinely different time,
  /// never conflate the two.
  fairMarketValuePerShareAtExercise Decimal @db.Decimal(24, 6)
  /// NULLABLE for the same reason InstrumentTermVersion.createdByUserId is — a direct-
  /// SQL-inserted row has nothing to set this from.
  recordedByUserId String?
  recordedByUser   User?    @relation("OptionExerciseRecordedBy", fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())
  dispositions     ShareDispositionEvent[]
  taxFilingRecords TaxFilingRecord[]

  @@index([instrumentId])
  @@index([exerciseDate])
}

/// v0.33.0 — a later SALE of shares that came from an ISO exercise (OptionExerciseEvent
/// above), needed ONLY to determine whether that exercise's disposition was
/// "qualifying" or "disqualifying" under IRC 422(a)'s holding-period test (more than 2
/// years after grant AND more than 1 year after exercise) — see
/// `classifyDisposition` in optionTaxCompliance.ts. Recording this is entirely
/// optional: an ISO exercise with no disposition event on file is simply treated as
/// "not yet known to have been sold" (never assumed qualifying OR disqualifying) —
/// this platform has no way to observe a stakeholder's personal brokerage activity on
/// its own, so this table only ever reflects what a user explicitly records.
/// Irrelevant to an NSO exercise (NSOs have no qualifying/disqualifying distinction),
/// so nothing here validates against the parent exercise's ISO/NSO status — that check
/// belongs to the report/API layer that surfaces this data, not a schema constraint.
model ShareDispositionEvent {
  id               String              @id @default(cuid())
  exerciseEventId  String
  exerciseEvent    OptionExerciseEvent @relation(fields: [exerciseEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dispositionDate  DateTime
  quantitySold     Decimal @db.Decimal(24, 6)
  salePricePerShare Decimal @db.Decimal(24, 6)
  recordedByUserId String?
  recordedByUser   User?    @relation("ShareDispositionRecordedBy", fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([exerciseEventId])
}

/// v0.46.0 — what KIND of reduction a forfeiture/expiration event represents, matching
/// (deliberately, by name) `AwardActivityEventType`'s "FORFEITED" | "EXPIRED" split in
/// src/lib/accounting/reporting.ts, which a 10-K-style award activity roll-forward
/// reports as two separate lines (an unvested grant someone left before vesting vs. a
/// fully-vested option nobody exercised before its contractual term ran out) — see
/// InstrumentForfeitureEvent's own doc comment for why this needed a real event log at
/// all rather than being folded into OptionExerciseEvent.
enum ForfeitureEventType {
  FORFEITED
  EXPIRED
}

/// v0.46.0 — George, verbatim, building the ASC 718/SEC-10-K award roll-forward report
/// ("beginning balance, additions, exercises, forfeitures, etc."): a real, append-only
/// EVENT log for the one reduction OptionExerciseEvent doesn't cover — a grant that
/// LAPSED rather than being exercised/vested. Modeled exactly like OptionExerciseEvent
/// (same "something that happened, once, on a specific date" reasoning — see that
/// model's doc comment) rather than as another InstrumentTermVersion or a value on
/// InstrumentStatus: `Instrument.status` is a single current-state field with no date
/// attached and (as of this version) is never written by any code path in this app, so
/// it can't answer "how many shares were forfeited BETWEEN these two dates," which is
/// exactly what a roll-forward needs.
///
/// Applies to STOCK_OPTION (unvested options forfeited pre-vest, or vested-but-
/// unexercised options that EXPIRE at the end of their contractual term — hence the two
/// ForfeitureEventType values), RSU, and RESTRICTED_STOCK (unvested RSUs/restricted
/// shares forfeited on termination — EXPIRED doesn't really apply to these, since
/// there's no "contractual term to exercise," but the API layer doesn't forbid it since
/// a company could still model an administrative cancellation that way).
///
/// `quantityForfeited` is deliberately NOT validated against "remaining unvested/
/// outstanding quantity" at the schema level (Postgres has no way to enforce that
/// against a JSON terms blob) — see the API route's own doc comment for the
/// best-effort application-layer check, same posture as OptionExerciseEvent's route.
model InstrumentForfeitureEvent {
  id                 String              @id @default(cuid())
  instrumentId       String
  instrument         Instrument          @relation(fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  forfeitureDate     DateTime
  quantityForfeited  Decimal             @db.Decimal(24, 6)
  eventType          ForfeitureEventType @default(FORFEITED)
  /// Free text — "Terminated without exercising," "Failed to meet performance
  /// condition," "Contractual term expired unexercised," etc. Optional: some companies
  /// won't bother recording why, and the roll-forward's numbers don't depend on it.
  reason             String?
  /// NULLABLE for the same reason OptionExerciseEvent.recordedByUserId is — a direct-
  /// SQL-inserted row (e.g. a data migration/backfill) has nothing to set this from.
  recordedByUserId   String?
  recordedByUser     User?               @relation("InstrumentForfeitureRecordedBy", fields: [recordedByUserId], references: [id])
  createdAt          DateTime            @default(now())

  @@index([instrumentId])
  @@index([forfeitureDate])
}

/// v0.33.0 — what kind of compliance obligation a TaxFilingRecord row tracks. Kept as
/// its own enum (not reused from anywhere else) because these are specifically the
/// filing/reporting OBLIGATIONS this platform currently knows how to detect and
/// compute data for — see optionTaxCompliance.ts's module doc comment for the exact
/// rule behind each one, and for what's deliberately NOT in this list yet (Form 3922/
/// ESPP has no instrument type in this schema at all; state-level filings; actual
/// payroll withholding-tax calculation, which belongs to a payroll system, not this
/// platform).
enum TaxFilingType {
  /// ISO exercise information return (IRC 6039) — furnished to the employee and filed
  /// with the IRS for the calendar year of exercise.
  FORM_3921
  /// The bargain element on an NSO exercise is ordinary income requiring payroll
  /// withholding and W-2 reporting — this platform flags the amount and the
  /// obligation; it does not compute withholding tax itself (see the module doc
  /// comment on why that's out of scope).
  W2_NSO_EXERCISE_INCOME
  /// A disqualifying disposition of ISO shares converts some of the gain to ordinary
  /// income, which the IRS expects reported (though, unlike an NSO exercise, without a
  /// company withholding obligation under Section 421(b)/422).
  W2_ISO_DISQUALIFYING_DISPOSITION
  /// Not a company filing at all — the EMPLOYEE files this with the IRS within 30 days
  /// of an early exercise/restricted grant. Tracked here only so a company can confirm
  /// it happened (or flag that the window closed with no confirmation on file), never
  /// as something this platform files on anyone's behalf.
  ELECTION_83B_DEADLINE
}

enum TaxFilingStatus {
  PENDING
  FILED
  /// Computed and then determined not to actually require filing after all (e.g. an
  /// ISO exercise that turned out, under the $100k rule, to be entirely
  /// recharacterized as NSO) — kept as a distinct status, not deleted, so the monthly
  /// report's history stays a complete, auditable record of every obligation it ever
  /// evaluated, not just the ones that stuck.
  NOT_REQUIRED
}

/// v0.33.0 — one row per compliance obligation the monthly report (optionTaxCompliance.ts's
/// `buildMonthlyComplianceReport`) has identified, so a user can mark it filed and never
/// see it nag again. Deliberately NOT recomputed and thrown away on every report run:
/// the underlying obligation (an exercise happened, a deadline falls due) is
/// deterministic and could be recomputed from OptionExerciseEvent/ShareDispositionEvent
/// alone, but WHETHER A HUMAN ACTUALLY FILED IT is state only a person can supply, and
/// that state has to persist somewhere durable — this table is that somewhere,
/// reconciled against freshly-computed obligations each time the report runs (a new
/// obligation gets a new PENDING row; an existing one keeps whatever status was
/// already recorded).
model TaxFilingRecord {
  id                 String            @id @default(cuid())
  entityId           String
  entity             Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  filingType         TaxFilingType
  /// The calendar year the obligation pertains to (the year of exercise/disposition
  /// for FORM_3921/W2_* — Form 3921 and W-2 are both annual filings even though the
  /// triggering event has a specific date within that year).
  taxYear            Int
  exerciseEventId    String?
  exerciseEvent      OptionExerciseEvent? @relation(fields: [exerciseEventId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// ELECTION_83B_DEADLINE traces back to the GRANT itself (a RESTRICTED_STOCK
  /// instrument's issue/transfer date starts the 30-day clock), not to an
  /// OptionExerciseEvent — there's no exercise involved in an 83(b) election at all.
  /// NULL for every other filingType, which all trace back through exerciseEventId
  /// instead. Same "degrade gracefully" ON DELETE SET NULL as exerciseEventId above,
  /// for the same reason (User.defaultEntityId's doc comment).
  instrumentId       String?
  instrument         Instrument?       @relation(fields: [instrumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status             TaxFilingStatus   @default(PENDING)
  filedDate          DateTime?
  filedByUserId      String?
  filedByUser        User?             @relation("TaxFilingRecordFiledBy", fields: [filedByUserId], references: [id])
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([entityId])
  @@index([exerciseEventId])
  @@index([instrumentId])
  // DEDUPE NOTE — this single Prisma @@unique is a BEST-EFFORT APPROXIMATION, not the
  // real constraint: because SQL treats every NULL as distinct from every other NULL,
  // a plain multi-column UNIQUE across both exerciseEventId and instrumentId fails to
  // catch a genuine duplicate whenever the OTHER of the two columns is NULL on both
  // rows (which is always true here — exactly one of the two is ever set on a given
  // row). The dedupe guarantee this table actually needs — "one row per
  // (entity, filingType, taxYear, exerciseEventId) among exercise-tied rows, and
  // separately one row per (entity, filingType, taxYear, instrumentId) among
  // instrument-tied rows" — requires two PARTIAL unique indexes (`WHERE
  // "exerciseEventId" IS NOT NULL` / `WHERE "instrumentId" IS NOT NULL`), which
  // Prisma's schema language cannot express without preview features unavailable in
  // this offline sandbox. db/schema.sql and the matching migration implement the two
  // partial indexes directly in raw SQL — THOSE are the real, verified constraint (see
  // db/validate.sql's duplicate-rejection tests); this @@unique is kept only so a
  // real `prisma migrate` run produces at least some protection until someone
  // upgrades this to the raw-SQL partial-index version via a follow-up migration.
  @@unique([entityId, filingType, taxYear, exerciseEventId, instrumentId])
}

// =============================================================================
// Board approval / consent record-keeping (v0.36.0)
// =============================================================================
/// A GOVERNANCE RECORD, DELIBERATELY NOT A WORKFLOW GATE. This does NOT block an
/// Instrument from being created, closed, or counted on the cap table — nothing in
/// `dispatch.ts`, `capTable.ts`, or the close workflow reads this table at all. That
/// is a considered scope decision, not an oversight: this platform's existing
/// InstrumentStatus enum (ACTIVE/CANCELLED/CONVERTED/EXERCISED/REPAID/EXTINGUISHED)
/// has no "pending approval" state, and every accounting engine, cap table rollup,
/// and close-workflow route in this codebase already assumes an ACTIVE instrument is
/// real and countable. Retrofitting a hard approval gate would mean touching every
/// one of those well-tested call sites to add a new state they'd all need to filter
/// out — a much larger, riskier change than what a "quick hit" governance record
/// needs to actually solve for a small company: a durable, dated record of WHAT the
/// board approved and WHEN, visible on the instrument/entity pages, that a CPA or
/// auditor can point to. If a hard pre-issuance approval gate is wanted later, it
/// belongs as its own, carefully-scoped follow-up — not bolted onto this table after
/// the fact.
///
/// One BoardConsent can cover MULTIPLE instruments at once (the common real-world
/// case: "the board approves the following option grants: ..."), via the
/// BoardConsentInstrument join table below — the same many-to-many shape this schema
/// already uses for User<->Entity (EntityAccess) and StakeholderUser<->Stakeholder
/// (StakeholderAccess), rather than a single instrumentId column that would force one
/// row per grant even when the board voted on all of them together in one action.
model BoardConsent {
  id              String                   @id @default(cuid())
  entityId        String
  entity          Entity                   @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  title           String
  description     String
  consentType     BoardConsentType
  /// The date the board actually acted (signed the written consent, or held the
  /// meeting) — NOT the date someone got around to recording it in this platform,
  /// which is `createdAt` below.
  decisionDate    DateTime
  createdByUserId String
  createdByUser   User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime                 @default(now())
  instruments     BoardConsentInstrument[]

  @@index([entityId])
}

enum BoardConsentType {
  WRITTEN_CONSENT
  BOARD_MEETING
}

/// Join table linking a BoardConsent to every Instrument it covers — see
/// BoardConsent's own doc comment for why this is many-to-many rather than a single
/// column on either side.
model BoardConsentInstrument {
  id             String       @id @default(cuid())
  boardConsentId String
  boardConsent   BoardConsent @relation(fields: [boardConsentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  instrumentId   String
  instrument     Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([boardConsentId, instrumentId])
  @@index([instrumentId])
}
