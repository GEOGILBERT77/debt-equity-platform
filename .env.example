# Copy this file to .env (local dev) and set the same two values as Environment
# Variables in Vercel for a deployed app. Both come from Supabase: Project Settings ->
# Database -> Connection string. See DEPLOYMENT.md for the full walkthrough.

# Pooled connection (PgBouncer, port 6543) -- what Prisma Client uses at runtime.
# Note the "?pgbouncer=true" suffix; without it, a serverless deploy will intermittently
# fail with "prepared statement already exists" errors under concurrent requests.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) -- what `prisma migrate` / `prisma db push` use. Schema
# changes can't run through the transaction pooler above.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# REQUIRED once you deploy anywhere reachable from outside your own machine (and for
# local dev too, once you want to actually log in rather than get redirected to
# /login). Signs and verifies the session cookie issued by POST /api/auth/login -- see
# src/lib/auth/session.ts. Generate a long random value once per deployment and never
# reuse it across environments; changing it instantly invalidates every existing
# session (everyone has to log in again), which is also how you'd force a global
# logout if you ever needed to. A quick way to generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# NOTE: earlier versions of this app (through v0.12.0) gated access with a single
# shared password (APP_ACCESS_PASSWORD/APP_ACCESS_PASSWORDS, HTTP Basic Auth) instead
# of real per-user login. That stopgap is gone as of v0.13.0 -- see the README's "Real
# authentication and multi-tenancy" section. If you're upgrading an existing
# deployment, remove those two env vars and set SESSION_SECRET instead; see
# DEPLOYMENT.md for the rest of the migration (you'll also need to run a bootstrap user
# into your database -- see db/seed.sql).
